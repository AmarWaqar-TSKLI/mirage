# Copy to .env and fill in. Never commit .env.

# Shared secret decoys use to send events to the controller.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MIRAGE_INGEST_TOKEN=change-me

# LLM for the SSH decoy's AI shell (OpenAI-compatible API).
LLM_BASE_URL=https://api.x.ai/v1
LLM_API_KEY=
LLM_MODEL=
