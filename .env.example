# Copy to .env, then fill in the secrets with:
#     python3 tools/gen_secrets.py
# Never commit .env.

# Each decoy's own token: it sends events with it and accepts control requests with it.
MIRAGE_TOKEN_ADMIN_PANEL=
MIRAGE_TOKEN_SSH=
MIRAGE_TOKEN_S3=

# Operator key for the dashboard's Contain / Release / Reset controls.
# ./demo up prints a sign-in link that carries it.
MIRAGE_OPERATOR_TOKEN=

# Optional LLM for the SSH decoy's planned AI shell layer (OpenAI-compatible API). Not used yet.
LLM_BASE_URL=https://api.x.ai/v1
LLM_API_KEY=
LLM_MODEL=
