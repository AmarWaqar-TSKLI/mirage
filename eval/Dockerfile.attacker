# Attacker/benign toolbox for the Mirage lab.
#
# The lab network is internal (no internet) at runtime, so every tool the
# campaign needs is baked in at build time. Build happens on the host, which
# has internet; only the running containers are offline.
FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        nmap \
        gobuster \
        hydra \
        curl \
        ca-certificates \
        sshpass \
        openssh-client \
        awscli \
        jq \
        wordlists \
    && rm -rf /var/lib/apt/lists/*

# gobuster wordlist (dirb common.txt ships with the `wordlists` package, gzipped).
RUN gunzip -kf /usr/share/wordlists/dirb/common.txt.gz 2>/dev/null || true

COPY eval/campaign.sh /opt/campaign.sh
COPY eval/benign.sh /opt/benign.sh
RUN chmod +x /opt/campaign.sh /opt/benign.sh

# Stay alive so the harness can `docker compose exec` the scripts on demand.
CMD ["sleep", "infinity"]
